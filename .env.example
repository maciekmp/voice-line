MIC_DEVICE=Your microphone name from npm run devices
WHISPER_BIN=C:\path\to\whisper-cli.exe
WHISPER_MODEL=C:\path\to\ggml-small.bin
# Optional: WHISPER_THREADS=8 (compare against whisper.cpp default 4)
COPILOT_VK=134
# Optional: CODEX_MODEL=gpt-6-luna (faster for short questions; otherwise uses Codex config.toml)
# Optional: FFMPEG_BIN=C:\path\to\ffmpeg.exe
# Optional: SAVE_AUDIO=1
# Optional: TTS_MODE=piper (default: sapi)
# Piper: PIPER_BIN=C:\path\to\piper.exe
# Piper: PIPER_MODEL=C:\path\to\pl_PL-gosia-medium.onnx (keep .onnx.json beside it)
# Optional: FFPLAY_BIN=C:\path\to\ffplay.exe (Piper playback; defaults to ffplay.exe on PATH)
# Optional: CHATGPT_BUTTON_VOICE=Paulina
# Optional: CHATGPT_BUTTON_TTS_RATE=2 (SAPI range: -10..10; default: 2)
# Optional fallback: CODEX_MODE=cli
# Optional: CODEX_EFFORT=low (set medium for more complex answers)
# Optional fallback: STT_MODE=cli
