{
  "name": "chatgpt-button",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "orb": "node scripts/launch-orb.cjs --preview",
    "test:orb": "node scripts/launch-orb.cjs --smoke-test",
    "test:audio-levels": "node --experimental-strip-types --test scripts/test-audio-levels.ts",
    "test:realtime": "node --experimental-strip-types --test scripts/test-realtime.ts",
    "test:voice-engine": "node --experimental-strip-types --test scripts/test-voice-engine.ts",
    "test:images": "node --experimental-strip-types --test scripts/test-images.ts",
    "test:realtime-wire": "node --experimental-strip-types scripts/test-realtime-wire.ts",
    "test:overlay": "node --test scripts/test-overlay.cjs",
    "test:answers": "node --test scripts/test-answers.js",
    "test:clipboard": "node --test scripts/test-clipboard.cjs",
    "test:copilot": "node --experimental-strip-types --test scripts/test-copilot.ts",
    "test:codex-errors": "node --experimental-strip-types --test scripts/test-codex-errors.ts",
    "test:conversation": "node --experimental-strip-types --test scripts/test-conversation-session.ts",
    "test:keyboard": "node --experimental-strip-types --test scripts/test-keyboard.ts",
    "preview:orb": "node --experimental-strip-types scripts/preview-orb.ts",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/launch-orb.cjs",
    "start:cli": "node --env-file=.env --experimental-strip-types src/main.ts",
    "debug": "node scripts/launch-orb.cjs --debug",
    "keys": "node --experimental-strip-types src/main.ts --debug-keys",
    "devices": "ffmpeg -hide_banner -list_devices true -f dshow -i dummy",
    "bench-stt": "node --env-file=.env --experimental-strip-types scripts/bench-stt.ts",
    "test:speaker": "node --experimental-strip-types scripts/test-speaker.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.5.1",
    "typescript": "^7.0.2"
  }
}
