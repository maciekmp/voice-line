{
  "name": "chatgpt-button",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/launch-orb.cjs",
    "start:cli": "node --env-file-if-exists=.env --experimental-strip-types src/main.ts",
    "start:debug": "node scripts/launch-orb.cjs --debug",
    "preview:desktop": "node scripts/launch-orb.cjs --preview",
    "preview:web": "node --experimental-strip-types scripts/preview-orb.ts",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.cjs unit",
    "test:integration": "node scripts/run-tests.cjs integration",
    "test:desktop": "node scripts/run-tests.cjs desktop",
    "test:keyboard": "node scripts/run-tests.cjs keyboard",
    "diagnose:keys": "node --experimental-strip-types scripts/diagnose-keys.ts",
    "diagnose:devices": "node scripts/diagnose-devices.cjs",
    "bench:stt": "node --env-file-if-exists=.env --experimental-strip-types scripts/bench-stt.ts",
    "probe:imagegen": "node --env-file-if-exists=.env --experimental-strip-types scripts/probe-imagegen.ts",
    "probe:image-history": "node --env-file-if-exists=.env --experimental-strip-types scripts/probe-image-history.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.5.1",
    "typescript": "^7.0.2"
  }
}
